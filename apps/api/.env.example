NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/careerprep
JWT_SECRET=change-me-to-a-long-random-string-of-32+chars
JWT_EXPIRES_IN_DAYS=7
COOKIE_SECURE=false
CLIENT_ORIGIN=http://localhost:3000

# --- Resume upload & parsing ---
MAX_UPLOAD_MB=5
# File storage: "local" (private folder, dev) or "s3" (any S3-compatible service)
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./storage
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=careerprep-resumes
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false
# Parsing mode: "local" (default; rule-based, no API key or external service needed)
# or "anthropic" (optional AI mode; also set ANTHROPIC_API_KEY)
AI_PROVIDER=local
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-sonnet-5-5
